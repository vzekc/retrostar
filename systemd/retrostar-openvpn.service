[Unit]
Description=RetroStar OpenVPN processes
After=network.target postgresql.service retrostar-bridge.service
Requires=postgresql.service retrostar-bridge.service

[Service]
Type=simple
RemainAfterExit=yes
ExecStart=/opt/retrostar/start-openvpn-servers.sh
# Starts the servers of new configurations; the running ones stay up.
ExecReload=/opt/retrostar/start-openvpn-servers.sh
ExecStop=/usr/bin/pkill openvpn
WorkingDirectory=/opt/retrostar
User=root

[Install]
WantedBy=multi-user.target
