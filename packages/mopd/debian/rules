#!/usr/bin/make -f

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

TOOLS = mopchk mopcopy mopprobe moptrace

%:
	dh $@

# The Makefile at the top is NetBSD's; Makefile.linux builds the Linux port.
override_dh_auto_build:
	$(MAKE) -f Makefile.linux mopd $(TOOLS)

override_dh_auto_test:

override_dh_auto_clean:
	$(MAKE) -f Makefile.linux clean

override_dh_auto_install:
	install -D -m 0755 mopd/mopd debian/mopd/usr/sbin/mopd
	for t in $(TOOLS); do install -D -m 0755 $$t/$$t debian/mopd/usr/bin/$$t; done

# Debug symbol packages stay out of the repository.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
