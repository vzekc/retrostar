#!/bin/bash
#
# lat-fotofix HOST PORT: a LAT session carried to fotofix's serial agent over
# raw TCP, naming the terminal server and its port in a first line before the
# machine's bytes:
#
#   fotofix-origin lat:<node>:<port>
#
# latd puts both in the session's environment. The agent records which port
# each photo file went out of, and the hall's exhibits are counted by it.

set -e

name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

exec 3<>"/dev/tcp/$1/$2"
printf 'fotofix-origin lat:%s:%s\n' "$(name "${LAT_REMOTE_NODE:-unknown}")" "$(name "${LAT_REMOTE_PORT:-unknown}")" >&3
exec /usr/bin/socat STDIO,raw,echo=0 FD:3
