#!/bin/bash

sysctl --system

# Remove any netplan configs that manage eth0 (ours or NM-generated)
for f in /etc/netplan/*.yaml /etc/netplan/*.yml; do
    [ -f "$f" ] || continue
    if grep -q 'eth0' "$f"; then
        echo "Entferne Netplan-Konfiguration: $f"
        rm "$f"
    fi
done

systemctl enable systemd-networkd
systemctl restart NetworkManager
systemctl daemon-reload
systemctl enable retrostar.service

cat <<\EOD
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
////////////////////////////////////////////////////////////////////////////////
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\

Der RetroStar-Client wurde installiert.  Die Netzwerk-Bridge (br0) wird
automatisch beim Booten eingerichtet.  Der RetroStar-Dienst startet
automatisch nach dem naechsten Neustart.  Du kannst ihn auch sofort starten:

        sudo systemctl start retrostar.service

////////////////////////////////////////////////////////////////////////////////
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
////////////////////////////////////////////////////////////////////////////////
EOD
